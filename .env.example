# ── Base de données ───────────────────────────────────────────────────────────
# N'importe quel Postgres. Sur Vercel, le plus simple est gratuit : Storage →
# Neon (Marketplace), qui pose DATABASE_URL toute seule — rien à copier ici,
# les tables se créent au premier build (script `vercel-build`).
# Avec Supabase : Project Settings → Database → Connection string → URI
# (pooler, mode session, port 5432) ; l'intégration Vercel la fournit sous le
# nom POSTGRES_URL, qui sert de repli automatique.
DATABASE_URL=postgresql://postgres.xxxx:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ── Administration ────────────────────────────────────────────────────────────
# Le mot de passe unique de /admin. Le changer déconnecte au prochain login.
ADMIN_PASSWORD=
# Clé de signature du cookie de session. La changer révoque toutes les sessions.
# Générer avec : openssl rand -base64 32
AUTH_SECRET=

# ── Site ──────────────────────────────────────────────────────────────────────
# URL canonique, sans barre oblique finale. Sert aux métadonnées de partage et
# à `event_source_url` des événements Meta.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── iClosed (facultatif) ──────────────────────────────────────────────────────
# Repli utilisé tant que rien n'est saisi dans /admin/reglages. La clé commence
# par `iclosed_` — le préfixe fait partie du token. L'identifiant de l'événement
# est le nombre visible dans l'URL d'édition de l'événement iClosed.
ICLOSED_API_KEY=
ICLOSED_EVENT_ID=

# ── Meta (facultatif) ─────────────────────────────────────────────────────────
# Repli utilisé tant que rien n'est saisi dans /admin/reglages. Les valeurs de
# l'administration ont toujours la priorité : elles se changent sans
# redéploiement, ce que ces variables ne permettent pas (Vercel les fige au build).
META_PIXEL_ID=
META_CAPI_TOKEN=

# ── Relecture IA (facultatif) ─────────────────────────────────────────────────
# Repli pour la clé Anthropic de la relecture des candidatures (pixel
# conditioning). Se règle et s'active dans /admin/reglages ; sans relecture
# activée, l'événement Meta part dès que le trafic vient de Meta.
ANTHROPIC_API_KEY=
